# =============================================================================
# AMD Token Factory
# =============================================================================
TOKEN_FACTORY_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
TOKEN_FACTORY_API_KEY=rc-your-48-hex-key-here
LLM_PRIMARY_MODEL=Gemma-4-31B-IT
LLM_FALLBACK_MODELS=Qwen3.8-Flash-Next,DeepSeek-V4-Flash

# =============================================================================
# Evolus
# =============================================================================
EVOLUS_API_KEY=evo_your-key-here
EVOLUS_APP_ID=your-workspace-uuid-here
EVOLUS_WORKFLOW_ID=
EVOLUS_EXTRACTOR_AGENT_ID=
EVOLUS_EXTRACTOR_ID=
EVOLUS_ROUTE_RISK_AGENT_ID=
EVOLUS_LIBRARY_ID=

# =============================================================================
# Gmail (OAuth — run scripts/gmail_auth.py once to get refresh token)
# =============================================================================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_MONITOR_ADDRESS=your-demo-mailbox@gmail.com

# =============================================================================
# Demo / routing
# =============================================================================
DEMO_MODE=true
DEMO_SINK_EMAIL=your-sink@example.com
TRADE_OPS_EMAIL=tradeops@example.com
FINANCE_EMAIL=finance@example.com
COMPLIANCE_EMAIL=compliance@example.com

# =============================================================================
# Google Places (optional — falls back to providers_seed.csv if absent)
# =============================================================================
GOOGLE_PLACES_API_KEY=

# =============================================================================
# World Labs spatial layer
# =============================================================================
FEATURE_SPATIAL=true
FEATURE_WORLDLABS_API=false
WORLDLABS_API_KEY=

# =============================================================================
# App
# =============================================================================
PUBLIC_BASE_URL=http://localhost:8000
RISK_THRESHOLD=Medium
DATABASE_URL=sqlite+aiosqlite:///./orbitra.db
